DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/starhoop
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/starhoop
APP_ENV=development

# --- Milestone 4: Modal orchestration + Cloudflare R2 ---------------------
# Set ENABLE_MODAL_ORCHESTRATION=true to mirror uploads to R2 and spawn the
# deployed Modal GPU job. Leave false for the legacy local-only upload flow.
ENABLE_MODAL_ORCHESTRATION=false

# Deployed Modal app/class (see modal_app/cv_app.py).
MODAL_APP_NAME=hoopstar-cv
MODAL_CLS_NAME=BasketballModels

# Public URL FastAPI is reachable at FROM Modal (use an ngrok tunnel in dev).
WEBHOOK_BASE_URL=http://localhost:8000
# Shared HMAC-SHA256 secret — put the SAME value in the Modal secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_HMAC_SECRET=

# Cloudflare R2 (S3-compatible) credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the derived endpoint (https://<account>.r2.cloudflarestorage.com).
R2_ENDPOINT_URL=
R2_PRESIGN_EXPIRY_SEC=3600
